# Copia este fichero como .env (ya está en .gitignore) y rellena los valores.
# Nunca subas el .env al repositorio.
#
# Contraseñas y secretos: usa valores aleatorios sin caracteres especiales
# (van dentro de la URI de MongoDB). Por ejemplo:
#   openssl rand -hex 24

# ── Perfil ───────────────────────────────────────────────────────────────────
# prod: sin datos de prueba; el primer admin sale de MATCHBAR_ADMIN_*.
# dev:  siembra usuarios de prueba con contraseña "password123" (incluido un
#       ADMIN). Úsalo SOLO en tu máquina.
SPRING_PROFILES_ACTIVE=prod

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=matchbar
MONGO_APP_PASSWORD=

# ── API ──────────────────────────────────────────────────────────────────────
# Obligatorio, mínimo 32 bytes: openssl rand -base64 48
JWT_SECRET=

# API key de https://www.football-data.org (vacía = sin sincronización real;
# en dev se usan partidos de prueba).
FOOTBALL_API_KEY=

# Primer administrador (solo perfil prod y solo si aún no existe ningún ADMIN).
# Contraseña de 12 caracteres como mínimo. Puedes vaciarlas tras el primer arranque.
MATCHBAR_ADMIN_EMAIL=
MATCHBAR_ADMIN_PASSWORD=

# ── Red ──────────────────────────────────────────────────────────────────────
# Interfaz en la que se publica el puerto 8080. 127.0.0.1 basta para el
# emulador; 0.0.0.0 solo para probar con un móvil físico en tu red local.
API_BIND=127.0.0.1

# Dominio para el proxy HTTPS (docker compose --profile tls up -d).
MATCHBAR_DOMAIN=
